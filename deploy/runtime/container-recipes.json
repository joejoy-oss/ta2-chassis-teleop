    "command": [
      "bash",
      "-c",
      "\ntrap \"kill \\$child 2> /dev/null; wait \\$child 2> /dev/null; exit 0\" TERM INT\nwhile true; do\n    echo \"$(date \"+%F %T %Z\") starting zenoh-bridge-ros2dds client -e $ZENOH_ENDPOINT -d $ROS_DOMAIN_ID\"\n    zenoh-bridge-ros2dds client -c /opt/openpi-client/zenoh-bridge-client.json5 -e \"$ZENOH_ENDPOINT\" \\\n        --no-multicast-scouting --ros-localhost-only -d \"$ROS_DOMAIN_ID\" &\n    child=$!\n    wait $child\n    echo \"$(date \"+%F %T %Z\") bridge exited with $?; restarting in 2 s\"\n    sleep 2\ndone >> /outputs/bridge.log 2>&1\n"
    ],
    "working_dir": "/app",
    "mounts": [
      {
        "source": "/data/ta2/software/deploy/client/openpi",
        "destination": "/app",
        "rw": false
      },
