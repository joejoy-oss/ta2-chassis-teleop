 impl Drop for RoutePublisher {
     fn drop(&mut self) {
+        // Stop the matching listener before deleting the DDS Reader: its callback holds the zenoh publisher, so
+        // left in the background it outlives the route and, at the next matching change, creates one more DDS
+        // Reader that routes every message once more (one more copy per removed route).
+        *self.alive.lock().unwrap_or_else(|e| e.into_inner()) = false;
+        if let Some(listener) = self.matching_listener.take() {
+            if let Err(e) = listener.undeclare().wait() {
+                tracing::warn!("{self}: failed to undeclare the matching listener: {e}");
+            }
+        }
         self.deactivate_dds_reader();
     }
 }
