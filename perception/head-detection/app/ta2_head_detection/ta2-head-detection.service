[Unit]
Description=TA2 head-camera YOLO26 workbench
After=network-online.target ta2-vision.service

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=render
StateDirectory=ta2-head-detection
WorkingDirectory=/data/ta2/head-detection
Environment=TA2_TRAIN_DEVICE=cpu
Environment=TA2_WEB_PYTHON=/data/ta2/head-detection/venv-cpu/bin/python
Environment=TA2_TRAIN_PYTHON=/data/ta2/head-detection/venv-cpu/bin/python
EnvironmentFile=-/data/ta2/head-detection/training.env
Environment=PYTHONUNBUFFERED=1
Environment=YOLO_CONFIG_DIR=/var/lib/ta2-head-detection/ultralytics
Environment=XDG_CACHE_HOME=/var/lib/ta2-head-detection/cache
Environment=YOLO_AUTOINSTALL=false
Environment=OMP_NUM_THREADS=4
ExecStart=/usr/bin/env ${TA2_WEB_PYTHON} app/ta2_head_detection/app.py --data /var/lib/ta2-head-detection --weights models/yolo26n.pt --device ${TA2_TRAIN_DEVICE}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
